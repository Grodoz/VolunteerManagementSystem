@using VolunteerManagementSystem.ViewModels
@model DataQualityDashboardViewModel

@{
    ViewData["Title"] = "Data Quality Dashboard";
}
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5">Data Quality Dashboard</h1>
            <p class="text-muted">
                Monitor data quality metrics across volunteer records.
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary shadow">
                <div class="card-body">
                    <h6 class="card-title">Total Volunteers</h6>
                    <h2>@Model.TotalVolunteers</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success shadow">
                <div class="card-body">
                    <h6 class="card-title">Quality Score</h6>
                    <h2>@Model.QualityScore%</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning shadow">
                <div class="card-body">
                    <h6 class="card-title">Duplicate Emails</h6>
                    <h2>@Model.DuplicateEmails</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-danger shadow">
                <div class="card-body">
                    <h6 class="card-title">Missing Emails</h6>
                    <h2>@Model.MissingEmails</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="row mt-4">

        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-light">
                    Data Quality Summary
                </div>
                <div class="card-body">

                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Metric</th>
                                <th>Count</th>
                            </tr>
                        </thead>
                        <tbody>

                            <tr>
                                <td>Total Volunteers</td>
                                <td>@Model.TotalVolunteers</td>
                            </tr>

                            <tr>
                                <td>Duplicate Emails</td>
                                <td>@Model.DuplicateEmails</td>
                            </tr>

                            <tr>
                                <td>Missing Emails</td>
                                <td>@Model.MissingEmails</td>
                            </tr>

                            <tr>
                                <td>Invalid Phone Numbers</td>
                                <td>@Model.InvalidPhoneNumbers</td>
                            </tr>

                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-light">
                    Quality Assessment
                </div>
                <div class="card-body">

                    @if (Model.QualityScore >= 90)
                    {
                        <div class="alert alert-success">
                            Excellent Data Quality
                        </div>
                    }
                    else if (Model.QualityScore >= 75)
                    {
                        <div class="alert alert-warning">
                            Moderate Data Quality Issues Detected
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            Significant Data Quality Issues Detected
                        </div>
                    }

                    <h5>Quality Score</h5>

                    <div class="progress" style="height: 30px;">
                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width:@Model.QualityScore%">
                            @Model.QualityScore%
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>
</div>