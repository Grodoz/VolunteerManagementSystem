@model IEnumerable<VolunteerManagementSystem.Models.Registration>

@{
    ViewData["Title"] = "Registrations";
}

<h1>Registrations</h1>

<p>
    <a asp-action="Create">Create Registration</a>

</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Volunteer</th>
            <th>Event</th>
            <th>Status</th>
            <th>Registration Date</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Volunteer?.FirstName
                    @item.Volunteer?.LastName
                </td>
                <td>
                    @item.Event?.EventName
                </td>
                <td>
                    @item.RegistrationStatus
                </td>
                <td>
                    @item RegistrationDate
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.RegistrationId">
                        Edit
                    </a>
                    |
                    <a asp-action="Details" asp-route-id="@item.RegistrationId">
                        Details
                    </a>
                    |
                    <a asp-action="Delete" asp-route-id="@item.RegistrationId">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>