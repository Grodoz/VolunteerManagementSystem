@model VolunteerManagementSystem.ViewModels.RegistrationIndexViewModel

@{
    ViewData["Title"] = "Registrations";
}

<h1>Registrations</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create Registration</a>

</p>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white shadow-sm">
            <div class="card-body">
                <h6>Total Registrations</h6>
                <h2>@Model.TotalRegistrations</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white shadow-sm">
            <div class="card-body">
                <h6>Registered</h6>
                <h2>@Model.RegisteredCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark shadow-sm">
            <div class="card-body">
                <h6>Waitlisted</h6>
                <h2>@Model.WaitlistedCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-danger text-white shadow-sm">
            <div class="card-body">
                <h6>Cancelled</h6>
                <h2>@Model.CancelledCount</h2>
            </div>
        </div>
    </div>
    <div class="card border-warning shadow-sm mb-4">
        <div class="card-header bg-warning">
            <h5 class="mb-4">Capacity Alerts</h5>
        </div>
        <div class="card-body">
            @if (Model.NearCapacityEvents == 0)
            {
                <div class="alert alert-success mb-0">
                    No events are approaching capacity.
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <strong>@Model.NearCapacityEvents</strong>
                    event(s) are at or about 80% capacity.
                </div>
                <ul class="list-group">
                    @foreach (var alert in Model.CapacityAlerts)
                    {
                        <li class="list-group-item">
                            @alert
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="card border-danger shadow-sm mb-4">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    Attendance Exceptions
                </h5>
            </div>
            <div class="card-body">
                @if (Model.AttendanceExceptions == 0)
                {
                    <div class="alert alert-success mb-0">
                        No attendance exceptions detected.
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        <strong>@Model.AttendanceExceptions</strong>
                        attendance exception(s) detected.
                    </div>
                    <ul class="list-group">
                        <li class="list-group-item">
                            Present with 0 hours:
                            <strong>@Model.PresentZeroHoursCount</strong>
                        </li>
                        <li class="list-group-item">
                            Excessive Hours (&gt; 12):
                            <strong>@Model.ExcessiveHoursCount</strong>
                        </li>
                        <li class="list-group-item">
                            Attendance Without Registration:
                            <strong>@Model.AttendanceWithoutRegistrationCount</strong>
                        </li>
                        <li class="list-group-item">
                            Missing Attendance Status:
                            <strong>@Model.MissingAttendanceStatusCount</strong>
                        </li>
                    </ul>
                }
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card bg-info text-white shadow-sm">
                    <div class="card-body">
                        <h6>Total Attendance</h6>
                        <h2>@Model.TotalAttendanceRecords</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success text-white shadow-sm">
                    <div class="card-body">
                        <h6>Present</h6>
                        <h2>@Model.PresentCount</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-danger text-white shadow-sm">
                    <div class="card-body">
                        <h6>Absent</h6>
                        <h2>@Model.AbsentCount</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-secondary text-white shadow-sm">
                    <div class="card-body">
                        <h6>Excused</h6>
                        <h2>@Model.ExcusedCount</h2>
                    </div>
                </div>
            </div>
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card bg-primary text-white shadow-sm">
                        <div class="card-body">
                            <h6>Total Volunteer Hours</h6>
                            <h2>@Model.TotalVolunteerHours</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<form asp-action="Index" method="get">
    <div class="row md-3">
        <div class="col-md-4">
            <label class="form-label">Event</label>
            <select name="eventId" asp-items="ViewBag.Events" class="form-select">
                <option value="">All Events</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Status</label>
            <select name="status" asp-items="ViewBag.Statuses" class="form-select">
                <option value="">All Statuses</option>
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">Apply Filters</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Clear</a>
        </div>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Volunteer</th>
            <th>Event</th>
            <th>Status</th>
            <th>Registration Date</th>
            <th>Actions</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Registrations)
        {
          <tr>
              <td>@item.Volunteer?.FullName</td>
              <td>@item.Event?.EventName</td>
              <td>@item.RegistrationStatus</td>
              <td>@item.RegistrationDate.ToString("MM/dd/yyyy")</td>
              <td>
                  <a asp-action="Edit" asp-route-id="@item.RegistrationId" class="btn btn-sm btn-warning">Edit</a>
                  <a asp-action="Details" asp-route-id="@item.RegistrationId" class="btn btn-sm btn-info">Details</a>
                  <a asp-action="Delete" asp-route-id="@item.RegistrationId" class="btn btn-sm btn-danger">Delete</a>
              </td>
          </tr>  
        }
    </tbody>
</table>