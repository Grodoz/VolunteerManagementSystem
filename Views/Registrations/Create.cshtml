@model VolunteerManagementSystem.Models.Registration

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Registration</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="VolunteerId" class="control-label">
                    Volunteer
                </label>
                <select asp-for="VolunteerId" class="form-control" asp-items="ViewBag.VolunteerId">

                </select>
            </div>

            <div class="form-group">
                <label asp-for="EventId" class="control-label">Event</label>
                <select asp-for="EventId" class="form-control" asp-items="ViewBag.EventId"></select>
            </div>

            <div class="form-group">
                <label asp-for="RegistrationDate" class="control-label"></label>
                <input asp-for="RegistrationDate" class="form-control" />
                <span asp-validation-for="RegistrationDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RegistrationStatus" class="control-label"></label>
                <input asp-for="RegistrationStatus" class="form-control" />
                <span asp-validation-for="RegistrationStatus" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Volunteer" class="control-label"></label>
                <input asp-for="Volunteer" class="form-control" />
                <span asp-validation-for="Volunteer" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Event" class="control-label"></label>
                <input asp-for="Event" class="form-control" />
                <span asp-validation-for="Event" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
